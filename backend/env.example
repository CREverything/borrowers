# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and only ever read by the backend process.

# TigerData connection string, from the TigerData console.
DATABASE_URL=postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require

# Clerk (Dashboard > API keys). The secret key stays on the server only.
# The publishable key can be omitted here if VITE_CLERK_PUBLISHABLE_KEY is in the root .env.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional: comma-separated frontend origins allowed to call protected endpoints.
# Defaults to the Vite dev and preview servers on localhost.
# CLERK_AUTHORIZED_PARTIES=https://borrowers.example.com

# Optional
PORT=3001
HOST=127.0.0.1
