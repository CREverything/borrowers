# Copy this file to .env in the project root and fill in real values.
# .env is git-ignored. Never commit real keys.

# --- Read by the browser app (Vite) ---
# Only VITE_ variables reach browser code. The Clerk publishable key is
# designed to be public. Never give a secret key a VITE_ name; the dev
# server refuses to start if you do.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Server only (Vite dev server and the backend) ---
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
CLERK_SECRET_KEY=sk_test_...
DATABASE_URL=postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
